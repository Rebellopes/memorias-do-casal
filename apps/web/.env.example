GOOGLE_CLIENT_SECRET=

# Se sincronizar com um álbum específico do Google Fotos (opcional)
# Substitua pelo ID do álbum (encontre no admin em /admin/integracoes)
GOOGLE_ALBUM_ID=

# Senha para acessar a área administrativa (/admin)
ADMIN_PASSWORD=
